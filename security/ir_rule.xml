<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 普通用户的任务记录规则 -->
        <record id="task_task_user_rule" model="ir.rule">
            <field name="name">Task: User can only see their own records</field>
            <field name="model_id" ref="model_oe_task"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理员的任务记录规则 -->
        <record id="task_task_admin_rule" model="ir.rule">
            <field name="name">Task: Admin can see all records</field>
            <field name="model_id" ref="model_oe_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 普通用户的任务结果记录规则 -->
        <record id="task_result_user_rule" model="ir.rule">
            <field name="name">Task Result: User can only see their own records</field>
            <field name="model_id" ref="model_oe_task_result"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 管理员的任务结果记录规则 -->
        <record id="task_result_admin_rule" model="ir.rule">
            <field name="name">Task Result: Admin can see all records</field>
            <field name="model_id" ref="model_oe_task_result"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo> 